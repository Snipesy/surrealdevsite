# Security headers for every response served from dist/. The Content-Security-Policy is appended at
# build time by scripts/headers.mjs, since it hashes the inline scripts. /api/* comes from the Worker.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()
  Cross-Origin-Opener-Policy: same-origin

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# Pagefind's search index uses its own extensions, which would otherwise go out without a Content-Type
/pagefind/*.pf_meta
  Content-Type: application/octet-stream
/pagefind/*.pf_index
  Content-Type: application/octet-stream
/pagefind/*.pf_fragment
  Content-Type: application/octet-stream
/pagefind/*.pagefind
  Content-Type: application/octet-stream

# Astro's build output has content hashes in the file names, so it never changes in place.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fixed names: keep for a day so the logo doesn't blink on every page, refresh in the background after that.
/logo-*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/badges/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
