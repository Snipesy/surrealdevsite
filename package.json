{
  "name": "surrealdev",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "predev": "node scripts/thumbs.mjs",
    "dev": "astro dev",
    "check": "node scripts/check-content.mjs",
    "prebuild": "node scripts/check-content.mjs",
    "build": "astro build && pagefind --site dist && node scripts/headers.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:branch": "node scripts/deploy-branch.mjs",
    "premedia": "node scripts/thumbs.mjs",
    "media": "node scripts/media.mjs",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "exif-reader": "^2.0.3",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.5",
    "wrangler": "^4.151.0",
    "yaml": "^2.9.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
