---
import { type Post, postUrl, excerptOf, isoDay, categoryBySlug, categoryUrl, readingMinutes, thumbUrl } from '../lib/posts';

interface Props {
  posts: Post[];
  showExcerpt?: boolean;
}
const { posts, showExcerpt = true } = Astro.props;
---

<ol class="post-list">
  {posts.map((post) => (
    <li class="post-row">
      <div class="post-meta mono">
        <time datetime={post.data.date.toISOString()}>{isoDay(post.data.date)}</time>
        <span class="dim">{readingMinutes(post)} min</span>
      </div>
      <div class="post-main">
        <h2 class="post-title"><a href={postUrl(post)}>{post.data.title}</a></h2>
        {showExcerpt && <p class="post-excerpt">{excerptOf(post)}</p>}
        {post.data.categories.length > 0 && (
          <p class="tags">
            {post.data.categories.map((c) => <a class="tag" href={categoryUrl(c)}>{categoryBySlug(c).name}</a>)}
          </p>
        )}
      </div>
      {post.data.cover && (
        <a class="post-thumb" href={postUrl(post)} tabindex="-1" aria-hidden="true">
          <img src={thumbUrl(post.data.cover)} alt="" loading="lazy" decoding="async" />
        </a>
      )}
    </li>
  ))}
</ol>
